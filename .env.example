# Base URL of the RankMeRabbit API the MCP server forwards to.
# Use the internal Docker network address if you proxy internally, e.g. http://dofollo-api:3001
DOFOLLO_API_BASE=https://api.rankmerabbit.com

# Scalekit OAuth resource server configuration.
SCALEKIT_ENVIRONMENT_URL=https://dofollo.scalekit.dev
SCALEKIT_CLIENT_ID=skc_130805008072442626
SCALEKIT_CLIENT_SECRET=
MCP_RESOURCE=https://mcp.rankmerabbit.com/mcp

# Shared secret for internal service-to-service calls into the Dofollo API.
INTERNAL_SERVICE_SECRET=

# Port the MCP server listens on (Caddy reverse-proxies to this).
PORT=3000
