# Base URL of the Dofollo API the MCP server forwards to.
# Use the internal Docker network address if you proxy internally, e.g. http://dofollo-api:8080
DOFOLLO_API_BASE=https://api.dofollo.ai

# Scalekit OAuth resource server configuration.
SCALEKIT_ENVIRONMENT_URL=https://dofollo.scalekit.dev
SCALEKIT_CLIENT_ID=skc_130805008072442626
SCALEKIT_CLIENT_SECRET=
MCP_RESOURCE=https://mcp.dofollo.ai/mcp

# Server-side Dofollo account key used for upstream API calls in the v1 single-account setup.
DOFOLLO_API_TOKEN=

# Port the MCP server listens on (Caddy reverse-proxies to this).
PORT=3000
